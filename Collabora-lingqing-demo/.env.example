# 前端开发端口
VITE_PORT=5174

# Collabora Online（CODE）浏览器入口
VITE_COLLABORA_URL=http://localhost:9980

# Collabora 容器访问本项目 WOPI 接口时使用的公网/宿主机地址。
# macOS/Windows Docker 可使用 host.docker.internal；Linux 请替换为宿主机 IP。
VITE_WOPI_PUBLIC_ORIGIN=http://host.docker.internal:5174

# 右侧对话面板 iframe 地址。留空则使用本应用内置 /aidoc/chatbox
# VITE_CHATBOX_URL=
